# ---- WhatsApp Business Cloud API (Meta) ----
# Leave WHATSAPP_TOKEN empty during local dev -> replies are printed to console.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=dev-verify-token
META_API_VERSION=v21.0

# ---- Ollama ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ---- Business rules ----
DATABASE_PATH=shop.db
CURRENCY=₦
# Money is in KOBO (integer). Shelf prices are treated as VAT-inclusive -> 0.
TAX_RATE=0
DELIVERY_FEE_KOBO=0
# Hours we hold reserved stock for a pay-on-pickup order
RESERVATION_HOURS=5
# Minutes a customer has to reply YES to a quote
QUOTE_TTL_MINUTES=10
# Extra minutes a customer can still collect after the hold ends
GRACE_MINUTES=30
# Reservations one phone may make in any rolling 24 hours (cancelled and expired ones count)
DAILY_RESERVATION_LIMIT=3
# How often expired holds are released
SWEEP_MINUTES=5
# Where per-turn diagnostics are written (metadata only)
LOG_DIR=logs
# Hours of silence before a chat is forgotten (branch lock, history)
SESSION_TTL_HOURS=24
# Hours the bot stays silent after handing a chat to a human
HANDOFF_HOURS=4
# Max chat messages kept and sent to the model
HISTORY_CAP=20

# Optional: where escalate_to_human posts handoff payloads (Slack/CRM webhook)
HUMAN_ESCALATION_WEBHOOK=

# ---- Brain: model lanes (Stage 4.1) ----
# Lanes are "provider:model", tried in this order: primary -> backup -> local.
# Providers: anthropic, openai, groq, gemini, openrouter, mistral, cerebras, ollama
#LLM_PRIMARY=anthropic:claude-haiku-5-5
#LLM_BACKUP=groq:openai/gpt-oss-120b
# Model names change (Groq retired llama-3.3-70b-versatile in Aug 2026). To see the names your key can use:
#   python -m check_lanes --models
#LLM_LOCAL=ollama:llama3.1:8b
# API keys (only for the providers you use). Never commit a real key.
#ANTHROPIC_API_KEY=
#GROQ_API_KEY=
#GEMINI_API_KEY=
# USD per million tokens (input,output) when the price is not built in; 0,0 for a free tier
#LLM_PRICE_PRIMARY=0.10,0.50
# Spend guard: paid lanes pause for the day at this budget (0 = no cap); alert at the percentage
DAILY_BUDGET_USD=0.50
BUDGET_ALERT_PERCENT=80
# Abuse guard: model turns per phone per hour, and the longest message the model will read
MODEL_TURNS_PER_HOUR=30
MAX_MESSAGE_CHARS=600
# Seconds to wait for a hosted / local model call
LLM_TIMEOUT_HOSTED=20
LLM_TIMEOUT_LOCAL=300
LLM_MAX_OUTPUT_TOKENS=300
# Local model memory: context window and how long it stays loaded
#LLM_WARM_UP=1   # load the local model at server start (only if the local lane is first)
OLLAMA_NUM_CTX=6144
OLLAMA_KEEP_ALIVE=1h
LIMITED_MODE_MESSAGE=We're a bit busy; the team will reply shortly.
