# ---- WhatsApp Business Cloud API (Meta) ----
# Leave WHATSAPP_TOKEN empty during local dev -> replies are printed to console.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=dev-verify-token
META_API_VERSION=v21.0

# ---- Ollama ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ---- Business rules ----
DATABASE_PATH=shop.db
CURRENCY=₦
# Money is in KOBO (integer). Shelf prices are treated as VAT-inclusive -> 0.
TAX_RATE=0
DELIVERY_FEE_KOBO=0
# Hours we hold reserved stock for a pay-on-pickup order
RESERVATION_HOURS=5
# Minutes a customer has to reply YES to a quote
QUOTE_TTL_MINUTES=10
# Extra minutes a customer can still collect after the hold ends
GRACE_MINUTES=30
# Reservations one phone may make in any rolling 24 hours (cancelled and expired ones count)
DAILY_RESERVATION_LIMIT=3
# How often expired holds are released
SWEEP_MINUTES=5
# Where per-turn diagnostics are written (metadata only)
LOG_DIR=logs
# Hours of silence before a chat is forgotten (branch lock, history)
SESSION_TTL_HOURS=24
# Hours the bot stays silent after handing a chat to a human
HANDOFF_HOURS=4
# Max chat messages kept and sent to the model
HISTORY_CAP=20

# Optional: where escalate_to_human posts handoff payloads (Slack/CRM webhook)
HUMAN_ESCALATION_WEBHOOK=
